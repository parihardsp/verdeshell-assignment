# ==============================================================================
# Environment Configuration - Mini Knowledge Assistant
# Copy this file to .env and configure values as needed.
# By default, providers are set to 'mock' for zero-dependency local evaluation.
# ==============================================================================

# Core Application Settings
APP_NAME="Mini Knowledge Assistant"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration (Async SQLite default)
DATABASE_URL=sqlite+aiosqlite:///data/knowledge_base.db

# Provider Modes: 'mock' (default, offline deterministic) | 'gemini' | 'groq'
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock

# Google Gemini API Settings (Optional if using 'mock' or 'groq')
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_LLM_MODEL=gemini-2.5-flash

# Groq API Settings (Optional if using 'mock' or 'gemini')
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# RAG Hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RESULTS=3
SIMILARITY_THRESHOLD=0.35

# Rate Limiting Guardrails (Per Client IP)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# File Upload Guardrails
MAX_FILE_SIZE_BYTES=5242880  # 5MB
ALLOWED_EXTENSIONS=[".txt", ".md", ".pdf", ".docx"]
