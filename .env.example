# ==============================================================================
# Mini Knowledge Assistant - Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure your secret credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Model Provider Selection (Standardized)
# ------------------------------------------------------------------------------
# Embedding Providers (2 choices):
#   - 'gemini' (Google Gemini: models/gemini-embedding-2, 3072-dim) [DEFAULT]
#   - 'mock'   (Mock Embeddings: offline deterministic 384-dim)
EMBEDDING_PROVIDER=gemini

# LLM Generation Providers (3 choices):
#   - 'gemini' (Google Gemini: gemini-flash-lite-latest via LangChain) [DEFAULT]
#   - 'groq'   (Groq: openai/gpt-oss-120b or llama-3.3-70b-versatile via LangChain)
#   - 'mock'   (Mock LLM: offline deterministic grounded synthesizer)
LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 2. Google Gemini API Configuration (Default Provider)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_MODEL=gemini-flash-lite-latest

# ------------------------------------------------------------------------------
# 3. Groq API Configuration (Fast LLM Alternative)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com

# ------------------------------------------------------------------------------
# 4. LangSmith / LangChain Observability & Tracing
# ------------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://aws.api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=Portfolio-Analytics-Agent-V1

# ------------------------------------------------------------------------------
# 5. Core Application & Server Settings
# ------------------------------------------------------------------------------
APP_NAME="Mini Knowledge Assistant"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# ------------------------------------------------------------------------------
# 6. Database & Persistent Storage Paths
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/knowledge_base.db
CHROMA_PERSIST_DIR=data/chroma_db
UPLOAD_DIR=data/uploads
MAX_FILES_PER_UPLOAD=5

# ------------------------------------------------------------------------------
# 7. RAG Hyperparameters & Precision Funnel Guardrails
# ------------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Retrieval candidate pool size per channel (Dense & BM25)
RETRIEVAL_TOP_K=15
# Final precision chunks provided to LLM synthesis after reranking
FINAL_TOP_N=3
TOP_K_RESULTS=3
# Reranker algorithm: 'groq' (Fast LLM Reranker), 'rrf' (Reciprocal Rank Fusion), 'mock'
RERANKER_TYPE=groq
GROQ_RERANKER_MODEL=openai/gpt-oss-120b
SIMILARITY_THRESHOLD=0.20
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_FILE_SIZE_BYTES=5242880
ALLOWED_EXTENSIONS=[".txt", ".md", ".pdf", ".docx"]

# ------------------------------------------------------------------------------
# 8. DeepEval Evaluation Framework (Powered by Groq)
# ------------------------------------------------------------------------------
# Evaluation execution mode: 'live' (real Groq LLM & Gemini embeddings) or 'mock' (offline deterministic, 0 tokens)
EVALUATION_MODE=live
# Automated RAG evaluations (Faithfulness, Recall, etc.) powered directly by Groq
# Unified model used for both extraction/synthesis and DeepEval judging
DEEPEVAL_MODEL=qwen/qwen3.8-27b
